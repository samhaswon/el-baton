set(EL_BATON_DEPLOYMENT_ROOT "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
if(DEFINED EL_BATON_DEPLOYMENT_ROOT_OVERRIDE)
  set(EL_BATON_DEPLOYMENT_ROOT "${EL_BATON_DEPLOYMENT_ROOT_OVERRIDE}")
endif()

set(EL_BATON_RETAINED_WEBENGINE_LOCALES
  "@EL_BATON_DEPLOY_WEBENGINE_LOCALES@")
set(EL_BATON_RETAIN_WEBENGINE_DEVTOOLS
  "@EL_BATON_DEPLOY_WEBENGINE_DEVTOOLS@")

file(GLOB_RECURSE EL_BATON_DEPLOYED_PAKS LIST_DIRECTORIES FALSE
  "${EL_BATON_DEPLOYMENT_ROOT}/*.pak")
foreach(EL_BATON_DEPLOYED_PAK IN LISTS EL_BATON_DEPLOYED_PAKS)
  get_filename_component(EL_BATON_PAK_NAME
    "${EL_BATON_DEPLOYED_PAK}" NAME)
  get_filename_component(EL_BATON_PAK_DIRECTORY
    "${EL_BATON_DEPLOYED_PAK}" DIRECTORY)
  get_filename_component(EL_BATON_PAK_PARENT
    "${EL_BATON_PAK_DIRECTORY}" NAME)

  if(EL_BATON_PAK_PARENT STREQUAL "qtwebengine_locales")
    get_filename_component(EL_BATON_LOCALE
      "${EL_BATON_DEPLOYED_PAK}" NAME_WE)
    if(NOT EL_BATON_LOCALE IN_LIST EL_BATON_RETAINED_WEBENGINE_LOCALES)
      file(REMOVE "${EL_BATON_DEPLOYED_PAK}")
    endif()
  elseif(NOT EL_BATON_RETAIN_WEBENGINE_DEVTOOLS AND
    EL_BATON_PAK_NAME MATCHES
      "^qtwebengine_devtools_resources(\\.debug)?\\.pak$")
    file(REMOVE "${EL_BATON_DEPLOYED_PAK}")
  endif()
endforeach()
