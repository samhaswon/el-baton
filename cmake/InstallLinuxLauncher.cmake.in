set(EL_BATON_INSTALL_ROOT "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(EL_BATON_LAUNCHER_DIRECTORY "${EL_BATON_INSTALL_ROOT}/usr/bin")
set(EL_BATON_LAUNCHER "${EL_BATON_LAUNCHER_DIRECTORY}/el-baton")

file(MAKE_DIRECTORY "${EL_BATON_LAUNCHER_DIRECTORY}")
file(REMOVE "${EL_BATON_LAUNCHER}")
file(CREATE_LINK "../../@EL_BATON_BIN_DESTINATION@/el-baton"
  "${EL_BATON_LAUNCHER}" SYMBOLIC)
