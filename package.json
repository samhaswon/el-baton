{
  "name": "el-baton-native-web-assets",
  "version": "0.1.0",
  "private": true,
  "description": "Build-time JavaScript assets for the native El Baton application",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate:emoji": "node scripts/generate_qt_emoji_map.mjs build/generated/emoji-shortcodes.json",
    "generate:cheatsheet": "node scripts/generate_qt_cheatsheet.mjs build/generated/cheatsheet.md",
    "generate": "npm run generate:emoji && npm run generate:cheatsheet"
  },
  "devDependencies": {
    "dompurify": "3.4.11",
    "gemoji": "8.1.0",
    "katex": "0.17.0",
    "mermaid": "11.16.1",
    "prismjs": "1.30.0",
    "typescript": "6.0.3"
  }
}
